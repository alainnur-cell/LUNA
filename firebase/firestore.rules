rules_version = '2';

// Deploy with:  firebase deploy --only firestore:rules   (from the firebase/ folder)
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function profilePath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function hasProfile() { return signedIn() && exists(profilePath()); }
    function me() { return get(profilePath()).data; }
    function isAdmin() { return hasProfile() && me().role == 'admin'; }

    // Each person can read their own profile. Only the admin tool (service account) writes them.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if false;
    }

    // A manager only sees shops where they are the Area Manager or the Regional Manager.
    match /shops/{shopCode} {
      allow read: if isAdmin()
        || (hasProfile() && (resource.data.areaManager == me().name
                             || resource.data.regionalManager == me().name));
      allow write: if false;
    }

    match /meta/{doc} {
      allow read: if hasProfile();
      allow write: if false;
    }

    // Everyone with an account reads broadcasts; only admins post or delete them.
    match /broadcasts/{id} {
      allow read: if hasProfile();
      allow create: if isAdmin()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.title is string && request.resource.data.title.size() <= 200
        && request.resource.data.body is string && request.resource.data.body.size() <= 5000;
      allow delete: if isAdmin();
      allow update: if false;
    }
  }
}
